# 复制为 .env 后再改：cp .env.example .env

# ---------------------------------------------------------------------------
# 阅读器（reader/）基线：默认本机自用（DEBUG 开、只听 127.0.0.1/localhost）。
# 要从局域网 / VPN 访问时才需要改下面三项 —— 对外访问前必须关 DEBUG 并换 key
# （reader 用默认 SECRET_KEY 且 DJANGO_DEBUG=0 时会拒绝启动，别绕过它）。
# ---------------------------------------------------------------------------
# DJANGO_DEBUG=0                     # 关 DEBUG（对外访问前必须关）
# DJANGO_ALLOWED_HOSTS=nas.local,localhost   # 允许的主机名，逗号分隔
# DJANGO_SECRET_KEY=换成随机长串

POSTGRES_USER=diting
POSTGRES_PASSWORD=diting
POSTGRES_DB=diting

# Miniflux 管理员（首次启动自动创建）
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=changeme

# ---------------------------------------------------------------------------
# LLM（Agnes，用于分级 / 摘要 / 聚类）
# 去 https://platform.agnes-ai.com → Settings → API Keys 创建
# ---------------------------------------------------------------------------
AGNES_API_KEY=sk-xxxxxxxxxxxxxxxx
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-3.0-flash

# 标题翻译是否优先走 agnes（免费但限速，失败自动回退 deepseek）。
# agnes 只承接标题翻译这类短任务；2 次 × 30s 仍失败即回退 deepseek（3 次 × 90s）。
# 也可在设置页「标题翻译」组里开，无需重启。默认关 = 行为与迁移前一致。
# TRANSLATE_PREFER_AGNES=0

# 主力通道选谁（deepseek / agnes）。旧名 TRIAGE_PROVIDER 仍可读，新名优先
# LLM_PROVIDER=deepseek

# ---------------------------------------------------------------------------
# LLM（DeepSeek，默认主力通道：敢判 L0 + 自动前缀缓存 + 1M 上下文）
# ★ DEEPSEEK_API_KEY 必填（LLM_PROVIDER 默认 deepseek）；
#   去 https://platform.deepseek.com 创建 key。换其他通道才可不填。
# 价目（2026-09-18 核实，USD/1M，非高峰）：输入 $0.15(未命中)/$0.003(命中)，输出 $0.60
# 高峰（周一至五 北京 09:00-12:00、14:00-18:00）翻倍；脚本会自动判定并报费用
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# 本地 ollama（--provider ollama）：免费、不外发数据
# ---------------------------------------------------------------------------
# OLLAMA_MODEL=qwen3:8b

# ---------------------------------------------------------------------------
# 预算池 · 日上限（¥）。五池独立计，到顶即停（不静默失败）。
# ★ 下面数字已按真实运行校准；开源部署没有 AppSetting 行，会直接吃这些值，
#   调高之前先看 /costs 的实际支出。优先级：/costs 写入 > 这里 > 代码默认。
# ---------------------------------------------------------------------------
# DAILY_BUDGET_CNY=3                # 旧单池兼容键，新部署不用设
# TRIAGE_BUDGET_CNY=0.6             # 分级（prompt_build 也计这池）
# SUMMARY_BUDGET_CNY=1.5            # 日报（S0~S3 共池）
# TRANSLATE_BUDGET_CNY=0.3          # 标题翻译
# WEEKLY_BUDGET_CNY=0.5             # 周报
# WIKI_BUDGET_CNY=0.5               # 知识库（对话/编译/提取/lint）

# 独立运维脚本调用 Miniflux API 时的认证（脚本清单见 scripts/README.md）
MINIFLUX_URL=http://localhost:8080
MINIFLUX_USER=admin
MINIFLUX_PASS=changeme

# ---------------------------------------------------------------------------
# B 站登录 cookie（可选；修 /bilibili/user/video/:uid 的 412 → Playwright 超时 → 503）
# config 里以 `BILIBILI_COOKIE_<uid>=<cookie>` 形式读取。
# ⚠ <uid> 是【你自己登录账号】的 uid，不是被订阅 UP 的 uid；配一条即全站通用。
# 配置方法参考 RSSHub 官方文档；SESSDATA 会过期，失效后用你自己账号的登录态重取。
# compose 里写成 BILIBILI_COOKIE_${BILIBILI_UID}=${BILIBILI_COOKIE}，所以这里填两行：
# ---------------------------------------------------------------------------
BILIBILI_UID=
BILIBILI_COOKIE=

# ---------------------------------------------------------------------------
# 其他需要登录态的源（都可选，留空即该路由不可用，不影响其它功能）
# 刻意列出空值：compose 里引用了这三个变量，留空能避免 `docker compose` 每次都报
# "variable is not set" 的警告，也方便你直接在该行后面粘贴。
# ---------------------------------------------------------------------------
ZHIHU_COOKIES=
TWITTER_AUTH_TOKEN=
ZSXQ_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# 系统通知（macOS，需要先装 terminal-notifier：brew install terminal-notifier）
# 用途：① L3 点名 —— 点击通知直达阅读器那一条（并自动展开正文）
#       ② 日报生成完成 —— 点击直达那天的日报页
#       ③ 日报生成失败 —— 点击去看 /summary（失败信息都记在那儿，静默失败会造成 FOMO）
# ---------------------------------------------------------------------------
NOTIFY_ENABLE=1
# NOTIFY_BACKEND=auto          # auto=按平台选；mac=terminal-notifier；win=Python shim→winotify
#                              # winotify 已在 requirements.txt（PEP 508 标记，仅 win32 装）
# NOTIFY_SHIM=                 # 留空=用随包的 core/notify_win.py（一般不用改）
# NOTIFY_L3=1                  # 关掉只想要日报通知
# NOTIFY_DAILY=1               # 日报生成**完成**
# NOTIFY_DAILY_FAIL=1          # 日报生成**失败**（独立开关，排查时可只关它）
# NOTIFY_SOUND=default         # 留空 = 静音
# NOTIFY_FAIL_SOUND=Basso      # 失败专用提示音；留空 = 失败静音
# NOTIFY_IGNORE_DND=0          # 1 = 穿透勿扰/专注模式
# NOTIFY_BIN=terminal-notifier
# NOTIFY_READER_BASE=http://127.0.0.1:8099
# NOTIFY_APP_ICON=             # 留空 = 自动用 static/favicon-256.png（白犬）

# ---------------------------------------------------------------------------
# 周期总结 · 休眠唤醒后的“等 feed 变新鲜”（2026-10-22 改造）
# 旧 SUMMARY_WAIT_MIN 已弃用；若仍配置，会作为 FRESH_DEADLINE_MIN 的 fallback。
# ---------------------------------------------------------------------------
# SUMMARY_FRESH_DEADLINE_MIN=30   # 补救刷新后最多等多久（轮询，不是盲睡）
# SUMMARY_FRESH_POLL_SEC=20       # 等待期间每多少秒复检一次
# SUMMARY_REFRESH_MAX=0           # 0 = 刷全部 stale；>0 = 每轮刷新上限
# SUMMARY_REFRESH_WORKERS=4       # 并发刷新数（每 worker 独立 Miniflux 客户端）
# SUMMARY_RETRY_TRANSIENT_ERRORS=1  # 窗口后 DNS/EOF/timeout/5xx 顺手重试（不进日报）
# SUMMARY_RETRY_TRANSIENT_MAX=20    # 每轮最多重试多少个窗口后错误源

# ---------------------------------------------------------------------------
# 周期总结 · 分层与缓存（S3 单篇 → S2 按源 → S1 按分类 → S0 全局）
# 注意 S=summary 层，不是分级 L；默认值见 config/settings.py
# ---------------------------------------------------------------------------
# SUMMARY_S3_CHARS=3000          # 单篇 > 此字数才走 S3 压缩
# SUMMARY_S2_MIN=8               # 单源 ≥ 此条数才走 S2
# SUMMARY_S2_BATCH=20            # 单源超过此数先分批再合并
# SUMMARY_S1_MIN_SOURCES=2       # S1 触发：分类内 ≥2 源
# SUMMARY_S1_MIN_ENTRIES=5       # 或 ≥5 条
# SUMMARY_FEED_MAX_ITEMS=40      # 单源条目过多阈值
# SUMMARY_FEED_L1_KEEP=20        # 超阈值时每源保留最近 K 条 L1；L2/L3 不丢
# SUMMARY_MAX_CALLS=120          # 单次运行调用上限（原 40 的三倍）
# SUMMARY_S0_RESERVE=1           # 下层给 S0 预留的调用数
# SUMMARY_CACHE_ENABLED=1        # S3/S2/S1 产物缓存（S0 不缓存）
# SUMMARY_CACHE_TTL_DAYS=7       # 缓存上限；输入指纹变了仍会立即重跑
# SUMMARY_S3_MAX_TOKENS=3000
# SUMMARY_S2_MAX_TOKENS=12000
# SUMMARY_S1_MAX_TOKENS=9000
# SUMMARY_S0_MAX_TOKENS=16000

# ---------------------------------------------------------------------------
# 标题翻译（中英对照）：feed 级开关默认关；只翻标题，不翻正文
# ---------------------------------------------------------------------------
# TRANSLATE_ENABLED=1              # 总开关（默认开；没有 feed 开启 = 零调用）
# TRANSLATE_LOOKBACK_DAYS=7        # 回填/新文章的发布时间窗口
# TRANSLATE_BACKFILL_MAX=50        # 每 feed 开启时回填上限 N
# TRANSLATE_PER_TICK_MAX=20        # 每 feed 每 tick 增量上限
# TRANSLATE_BATCH_SIZE=20          # 一次 LLM 调用翻多少条标题
# TRANSLATE_BATCH_CHARS=4000       # 单批标题总字符上限（超了拆批）
# TRANSLATE_TICK_SEC=300           # 增量扫描间隔（秒）
# TRANSLATE_SCAN_MIN=5             # 同一 feed 两次扫描的最小间隔（分钟）
# TRANSLATE_SCAN_LIMIT=500         # 每个 feed 每轮拉多少条条目
# TRANSLATE_CHAR_LIMIT=400         # 超长标题跳过（不截半句）
# TRANSLATE_MAX_TOKENS=2048        # 单批输出预算
# TRANSLATE_MAX_ATTEMPTS=3         # 单条自动重试上限
# TRANSLATE_MAX_CALLS_PER_DAY=200  # 非 DeepSeek 无法估费时的调用次数兜底
# （翻译池日预算见上方「预算池」段）

# ---------------------------------------------------------------------------
# 知识库 / wiki（划线批注已有；对话/编译/lint 是阶段 2）
# ---------------------------------------------------------------------------
# WIKI_DIR=/path/to/obsidian/vault   # wiki 落盘根（默认 data/wiki；可指向 Obsidian vault）
# WIKI_CHAT_ENABLED=1              # 对话开关（阶段 2.1，非流式 v1）
# WIKI_CHAT_ARTICLE_CHARS=6000     # 正文进 prompt 的字数上限（每轮都重发，越大越贵）
# WIKI_CHAT_HISTORY=6              # 带多少条历史消息进上下文（UI 仍显示全量）
# WIKI_CHAT_MAX_TOKENS=3072        # 单轮输出预算（含推理链）
# WIKI_CHAT_QUESTION_CHARS=2000    # 单条提问长度上限
# 审批浮层「找找相关页」是否优先走 agnes（免费但限速，2 次 × 15s 后回退 deepseek）。
# 也可在设置页「知识库」组里开，无需重启。默认关 = 行为与迁移前一致。
# WIKI_RELATED_PREFER_AGNES=0
